[sub_resource type="GDScript" id="GDScript_mwb40"]
script/source = "extends StaticBody2D


var back_music:=AudioStreamPlayer.new()
var Enemy_count=0
var Score=0
var timr=0.0
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	back_music.stream=load(\"res://Bounce.wav\")
	back_music.autoplay=true
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	#$timr+=delta
	#$HUD/TIME.text=str(timr)
	if Enemy_count<5:
		Enemy_count+=1
		var blob = preload(\"res://blob.tscn\")
		var newblob = blob.instantiate()
		var rand_vec=Vector2.ZERO
		rand_vec.x=(0.5-randf())*1000
		rand_vec.y=(0.5-randf())*1000
		newblob.global_position=global_position+rand_vec
		add_child(newblob)
"

[sub_resource type="GDScript" id="GDScript_feb5d"]
script/source = "extends CharacterBody2D

const SPEED = 10.0
const Shoot_delay=3
var bullet_amount=0

func _physics_process(delta: float) -> void:
	if Input.is_action_pressed(\"left\"):
		move_local_x(-SPEED)
	if Input.is_action_pressed(\"right\"):
		move_local_x(SPEED)
	if Input.is_action_pressed(\"down\"):
		move_local_y(SPEED)
	if Input.is_action_pressed(\"up\"):
		move_local_y(-SPEED)
	
	move_and_collide(velocity*delta)
	if Input.is_action_pressed(\"click\")&&bullet_amount<500 :
		bullet_amount+=1
		var shoot_dir=Vector2.ZERO
		var rand_vec=Vector2.ZERO
		rand_vec.x=randf()
		rand_vec.y=randf()
		shoot_dir=get_global_mouse_position()-global_position+rand_vec.normalized()*10
		var bullet = preload(\"res://bullet.tscn\")
		var newbullet = bullet.instantiate()
		newbullet.global_position = global_position+shoot_dir.normalized()*50+rand_vec.normalized()*30
		newbullet.velocity=shoot_dir.normalized()*1000
		get_parent().add_child(newbullet)
func _on_player_entered_body(_body):
		hide()
	#
	##if velocity.length()!=0:
		##velocity=velocity.normalized()*SPEED
		##$AnimatedSprite2D.play()
	##else:
		##$AnimatedSprite2D.stop()
	##
	#
	#move_and_slide()

 
"

