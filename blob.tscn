script/source = "extends CharacterBody2D


const SPEED = 300.0
const JUMP_VELOCITY = -400.0


func _physics_process(delta: float) -> void:
	if get_slide_collision_count()>0:
		var Game=get_parent()
		Game.Score+=1
		Game.Enemy_count-=1
		queue_free()
	move_and_slide()
"

